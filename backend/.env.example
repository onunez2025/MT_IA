# SOLE AI — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# Azure SQL Server (SAP SD data — soledb-puntoventa)
AZURE_SQL_SERVER=your-azure-server.database.windows.net
AZURE_SQL_DATABASE=your-azure-database
AZURE_SQL_USER=your-azure-sql-user
AZURE_SQL_PASSWORD=your-azure-sql-password

# SQL Server Local (SIG — forecast/metas)
SQL_SERVER=your-local-sql-server
SQL_DATABASE=SIG
SQL_USER=your-sql-user
SQL_PASSWORD=your-sql-password

# SQL PUNTO_VENTA — Maestro de materiales SAP (distingue productos de servicios)
# Si PV_SQL_SERVER está vacío, usa el mismo server/user/pass que SQL_SERVER.
# En producción (EasyPanel/cloud): apuntar a la réplica Azure o dejar vacío
# para desactivar el filtro (las queries funcionan igual, sin filtrar servicios).
PV_SQL_SERVER=               # vacío = mismo que SQL_SERVER
PV_SQL_DATABASE=PUNTO_VENTA  # nombre de la base de datos
PV_SQL_USER=                 # vacío = mismo que SQL_USER
PV_SQL_PASSWORD=             # vacío = mismo que SQL_PASSWORD

# SAP Connections
SAP_HOST=your-sap-host.example.com
SAP_USER=your-sap-user
SAP_PASSWORD=your-sap-password

# Deepseek API (LLM — Fase 0)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Application Settings (Development)
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
